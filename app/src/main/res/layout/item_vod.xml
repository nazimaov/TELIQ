<?xml version="1.0" encoding="utf-8"?>

<!-- Плитка фильма/сериала: постер 2:3, название, год и качество -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/tile_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <com.teliq.tv.ui.PosterView
        android:id="@+id/vod_poster"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/snap_bg"
        android:contentDescription="Постер"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/vod_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/tile_name_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/vod_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/tile_prog_size" />
</LinearLayout>
