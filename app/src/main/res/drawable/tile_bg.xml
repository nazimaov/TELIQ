<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
        <gradient android:angle="270" android:startColor="#FF1F5FB0" android:endColor="#FF4A3DBD" />
        <corners android:radius="16dp" />
        <stroke android:width="3dp" android:color="#FF7FE0FF" />
    </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
        <gradient android:angle="270" android:startColor="#FF1F5FB0" android:endColor="#FF4A3DBD" />
        <corners android:radius="16dp" />
        <stroke android:width="3dp" android:color="#FF7FE0FF" />
    </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
        <gradient android:angle="270" android:startColor="#FF151F66" android:endColor="#FF1B1160" />
        <corners android:radius="16dp" />
        <stroke android:width="2dp" android:color="#FF4A46E0" />
    </shape>
    </item>
</selector>
