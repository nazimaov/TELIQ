<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_focused="true">
        <shape android:shape="rectangle">
        <gradient android:angle="0" android:startColor="#FF1FA3E6" android:endColor="#FF7A4DE0" />
        <corners android:radius="24dp" />
        <stroke android:width="3dp" android:color="#FFFFFFFF" />
    </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
        <gradient android:angle="0" android:startColor="#FF1FA3E6" android:endColor="#FF7A4DE0" />
        <corners android:radius="24dp" />
        <stroke android:width="1dp" android:color="#FF9FE6FF" />
    </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="#FF7FE0FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#666E96FF" />
        </shape>
    </item>
</selector>
