<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
        <gradient android:angle="0" android:startColor="#FF1FA3E6" android:endColor="#FF8A4FE8" />
        <corners android:radius="14dp" />
        <stroke android:width="3dp" android:color="#FFFFFFFF" />
    </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
        <gradient android:angle="0" android:startColor="#CC1FA3E6" android:endColor="#CC8A4FE8" />
        <corners android:radius="14dp" />
        <stroke android:width="2dp" android:color="#FF9FE6FF" />
    </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#506E96FF" />
        </shape>
    </item>
</selector>
