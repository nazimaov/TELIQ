<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Выделен для перемещения — оранжевая «горящая» рамка -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC3A2A14" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#FFFFB347" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FF7FE0FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#506E96FF" />
        </shape>
    </item>
</selector>
